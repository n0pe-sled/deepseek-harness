{
  "name": "fixture_mcp",
  "type": "stdio",
  "source": {
    "default": "https://example.invalid/fixture.git",
    "override_env": "FIXTURE_MCP_SOURCE"
  },
  "run": {
    "command": "uv",
    "args": ["--directory", "/path/to/fixture", "run", "main.py"],
    "entrypoint": "main.py"
  },
  "secrets": ["FIXTURE_TOKEN"],
  "configuration": ["FIXTURE_URL"]
}
